%% APP_FLOW.mmd — mifos-x-open-banking full navigation graph
%% Generated 2026-05-25 by /idea sync STEP 4a
%% Rebuilt 2026-06-12 by /idea sync STEP 4a — MIGRATION OBP → HSBC reconcile (50→39 screens).
%%   Removed: Login, Cards, CardDetail, FxRates, ScaChallenge, ChangePassword + the entire
%%   12-screen Field Officer persona. Added the OBIE consent + redirect screens
%%   (consent-intro/request/declined/expired, bank-authorize-handoff, auth-callback,
%%   payment-authorize-handoff, payment-declined). Single consumer persona, consent-gated.
%% Source of truth: flows/{app-main,account-access-consent,consumer-banking,payment-initiation}.yaml
%% HSBC UK/CE Open Banking sandbox: https://secure.sandbox.ob.hsbc.co.uk

flowchart TB

  %% ──────────── Entry ────────────
  Launch([App Launch]) --> Splash

  %% ──────────── Consent Onboarding (gates everything) ────────────
  subgraph consent_group ["Account-Access Consent (OBIE AIS)"]
    direction TB
    Splash[Splash\nconsent + token check]
    ConsentIntro[Consent Intro\nexplain data sharing]
    ConsentRequest[Consent Request\npick permissions → AWAU]
    BankAuthorizeHandoff[Bank Authorize\nHandoff → HSBC]
    AuthCallback[Auth Callback\ncode → token → AUTH]
    ConsentDeclined[Consent\nDeclined]
    ConsentExpired[Consent\nExpired]
  end

  Splash -->|no valid consent| ConsentIntro
  Splash -->|valid AUTH consent + token| Home
  Splash -->|consent EXPD/RJCT/revoked| ConsentExpired
  ConsentIntro --> ConsentRequest
  ConsentIntro -.->|terms| TermsOfService
  ConsentIntro -.->|privacy| PrivacyPolicy
  ConsentRequest -->|grant → POST account-access-consents| BankAuthorizeHandoff
  ConsentRequest -->|back| ConsentIntro
  BankAuthorizeHandoff -->|external redirect: PSU authenticates + SCA at HSBC| AuthCallback
  AuthCallback -->|consent AUTH| Home
  AuthCallback -->|callback error / declined| ConsentDeclined
  ConsentDeclined -->|try again| ConsentRequest
  ConsentExpired -->|re-grant| ConsentRequest

  %% ──────────── Consumer Banking (AISP, read-only, consent-gated) ────────────
  subgraph consumer_group ["Consumer Banking (AISP)"]
    direction TB

    subgraph core_banking ["Core Banking"]
      Home[Home\nDashboard]
      Accounts[Accounts]
      AccountDetail[Account\nDetail]
      Transactions[Transactions]
      TransactionDetail[Transaction\nDetail]
      TransactionTags[Transaction\nTags]
      Beneficiaries[Beneficiaries\nread-only]
      StandingOrders[Standing\nOrders]
      StandingOrderDetail[Standing Order\nDetail]
      StandingOrderEdit[Standing Order\nEdit]
      DirectDebits[Direct Debits]
      DirectDebitDetail[Direct Debit\nDetail]
    end

    subgraph enhancements ["Insights & Discovery"]
      AtmLocator[ATM / Branch\nLocator]
      Notifications[Notifications\nevent feed]
      PfmDashboard[Spending\nInsights]
      PfmSettings[PFM\nSettings]
      BusinessInsights[Business\nInsights]
      Products[Products\nOpen Data]
      ConsentManager[Consent\nManager]
    end
  end

  %% Consumer navigation
  Home --> Accounts
  Home --> SendMoney
  Home --> Transactions
  Home --> Beneficiaries
  Home --> StandingOrders
  Home --> DirectDebits
  Home --> AtmLocator
  Home --> Notifications
  Home --> PfmDashboard
  Home --> Products
  Home -.->|more| Profile
  Home -.->|more| Settings

  Accounts --> AccountDetail
  AccountDetail --> Transactions
  AccountDetail --> SendMoney
  AccountDetail --> StandingOrders
  AccountDetail --> DirectDebits

  Transactions --> TransactionDetail
  TransactionDetail -.->|tag/note| TransactionTags

  Beneficiaries --> SendMoney

  StandingOrders --> StandingOrderCreate
  StandingOrders --> StandingOrderDetail
  StandingOrderDetail --> StandingOrderEdit
  StandingOrderEdit -->|save / cancel| StandingOrderDetail
  StandingOrderDetail -->|back| StandingOrders

  DirectDebits --> DirectDebitDetail
  DirectDebitDetail -->|back| DirectDebits

  PfmDashboard --> Transactions
  PfmDashboard --> PfmSettings
  PfmDashboard --> BusinessInsights
  Products --> Accounts

  %% ──────────── Payments (PISP — consent → authorise → submit → status) ────────────
  subgraph payment_group ["Payment Initiation (PISP)"]
    direction TB
    SendMoney[Send Money\npick payee + kind]
    SendMoneyAmount[Send Money\nAmount + CoF check]
    SendMoneyConfirm[Send Money\nConfirm → AWAU]
    PaymentAuthorizeHandoff[Payment Authorize\nHandoff → HSBC]
    PaymentResult[Payment\nResult]
    PaymentDeclined[Payment\nDeclined]
    StandingOrderCreate[Create Standing\nOrder → PISP]
  end

  SendMoney --> SendMoneyAmount
  SendMoneyAmount -->|funds OK| SendMoneyConfirm
  SendMoneyAmount -->|back| SendMoney
  SendMoneyConfirm -->|confirm → POST payment-consents| PaymentAuthorizeHandoff
  SendMoneyConfirm -->|edit| SendMoneyAmount
  PaymentAuthorizeHandoff -->|external redirect: SCA at HSBC| AuthCallback
  AuthCallback -->|payment submitted + settled| PaymentResult
  AuthCallback -->|payment declined / RJCT| PaymentDeclined
  PaymentResult --> TransactionDetail
  PaymentResult -->|done| Home
  PaymentDeclined -->|try again| SendMoneyConfirm
  StandingOrderCreate -->|back / created| StandingOrders

  %% ──────────── App / Profile / Legal ────────────
  subgraph app_group ["App / Profile / Legal"]
    direction TB
    Profile[Profile]
    Settings[Settings]
    About[About]
    TermsOfService[Terms of\nService]
    PrivacyPolicy[Privacy\nPolicy]
    Licenses[Licenses]
  end

  Settings --> ConsentManager
  Settings --> About
  ConsentManager -->|back| Settings
  ConsentManager -.->|disconnect — revoke all consents| ConsentIntro
  Profile --> ConsentManager
  Profile -.->|disconnect HSBC| ConsentIntro
  About --> TermsOfService
  About --> PrivacyPolicy
  About --> Licenses
  TermsOfService -->|back| About
  PrivacyPolicy -->|back| About
  Licenses -->|back| About

  %% ──────────── Styling ────────────
  classDef consent fill:#4C662B,stroke:#354E16,color:#fff
  classDef consumer fill:#386A20,stroke:#224B0C,color:#fff
  classDef payment fill:#55624C,stroke:#3A4A34,color:#fff
  classDef app fill:#5C5F52,stroke:#444735,color:#fff
  classDef entry fill:#F9FAEF,stroke:#1A1C16,color:#1A1C16

  class Splash,ConsentIntro,ConsentRequest,BankAuthorizeHandoff,AuthCallback,ConsentDeclined,ConsentExpired consent
  class Home,Accounts,AccountDetail,Transactions,TransactionDetail,TransactionTags,Beneficiaries,StandingOrders,StandingOrderDetail,StandingOrderEdit,DirectDebits,DirectDebitDetail,AtmLocator,Notifications,PfmDashboard,PfmSettings,BusinessInsights,Products,ConsentManager consumer
  class SendMoney,SendMoneyAmount,SendMoneyConfirm,PaymentAuthorizeHandoff,PaymentResult,PaymentDeclined,StandingOrderCreate payment
  class Profile,Settings,About,TermsOfService,PrivacyPolicy,Licenses app
  class Launch entry
